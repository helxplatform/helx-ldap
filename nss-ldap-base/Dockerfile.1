FROM ubuntu:25.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates \
    build-essential pkg-config \
    autoconf automake libtool \
    libldap2-dev libsasl2-dev libkrb5-dev \
    dpkg-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth=1 https://github.com/PADL/nss_ldap.git
WORKDIR /src/nss_ldap

# Fix missing kerberos GSS declaration
RUN sed -i '/#include <gssapi\/gssapi.h>/a #include <gssapi/gssapi_krb5.h>' ldap-nss.c

# Fix asprintf() type mismatch
RUN sed -i 's/const char \*filterEntryDN/char *filterEntryDN/' ldap-grp.c

RUN set -eux; \
    multiarch="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"; \
    autoreconf -fi; \
    ./configure --prefix=/usr --libdir="/usr/lib/$multiarch"; \
    make -j"$(nproc)"; \
    make DESTDIR=/out install

FROM ubuntu:25.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libldap2 libsasl2-2 libkrb5-3 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/usr/lib/ /usr/lib/

RUN set -eux; \
    multiarch="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"; \
    mkdir -p "/lib/$multiarch"; \
    for f in /usr/lib/$multiarch/libnss_ldap.so.*; do \
        ln -sf "$f" "/lib/$multiarch/$(basename "$f")"; \
    done
